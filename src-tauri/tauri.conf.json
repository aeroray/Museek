{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Museek",
  "version": "../package.json",
  "identifier": "com.museek.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1425",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Museek",
        "width": 1200,
        "height": 786,
        "minWidth": 1200,
        "minHeight": 786,
        "center": true,
        "visible": false,
        "decorations": true,
        "transparent": true,
        "shadow": false,
        "backgroundColor": [0, 0, 0, 0],
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 18
        }
      },
      {
        "label": "lyrics",
        "title": "Museek Desktop Lyrics",
        "width": 720,
        "height": 196,
        "minHeight": 172,
        "center": true,
        "visible": false,
        "focus": true,
        "focusable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "backgroundColor": [0, 0, 0, 0]
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "requireLiteralLeadingDot": false,
          "allow": [
            "**/*",
            "$HOME/**/*",
            "$DESKTOP/**/*",
            "$DOCUMENT/**/*",
            "$DOWNLOAD/**/*",
            "$AUDIO/**/*",
            "$APPDATA/**/*",
            "$APPLOCALDATA/**/*",
            "$RESOURCE/**/*"
          ]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],
    "createUpdaterArtifacts": true,
    "category": "Music",
    "shortDescription": "Museek — multi-platform desktop music aggregator",
    "longDescription": "Museek (拾音) is a cross-platform desktop music aggregator with multi-source search, charts, playlists, synced lyrics, and downloads. Compatible with lx-music sources.",
    "copyright": "Copyright © 2026 Museek. MIT License.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    },
    "fileAssociations": [
      {
        "ext": ["mp3"],
        "mimeType": "audio/mpeg",
        "name": "MP3 Audio",
        "description": "MP3 Audio",
        "role": "Viewer",
        "rank": "Default"
      },
      {
        "ext": ["flac"],
        "mimeType": "audio/flac",
        "name": "FLAC Audio",
        "description": "FLAC Audio",
        "role": "Viewer",
        "rank": "Default"
      },
      {
        "ext": ["m4a"],
        "mimeType": "audio/mp4",
        "name": "M4A Audio",
        "description": "M4A Audio",
        "role": "Viewer",
        "rank": "Default"
      },
      {
        "ext": ["aac"],
        "mimeType": "audio/aac",
        "name": "AAC Audio",
        "description": "AAC Audio",
        "role": "Viewer",
        "rank": "Default"
      },
      {
        "ext": ["ogg"],
        "mimeType": "audio/ogg",
        "name": "Ogg Audio",
        "description": "Ogg Audio",
        "role": "Viewer",
        "rank": "Default"
      },
      {
        "ext": ["wav"],
        "mimeType": "audio/wav",
        "name": "WAV Audio",
        "description": "WAV Audio",
        "role": "Viewer",
        "rank": "Default"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true,
      "dmg": {
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 },
        "windowSize": { "width": 660, "height": 400 }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVFRjAyMTFEOTYwRTlERTYKUldUbW5RNldIU0h3WGthRGI5cVRseTF4KzFmcnd2V0FPOXJJdE01aG8zcFhHMHdRNkNmOVU2SFgK",
      "endpoints": [
        "https://gh-proxy.com/https://github.com/aeroray/Museek/releases/latest/download/latest.json",
        "https://ghproxy.net/https://github.com/aeroray/Museek/releases/latest/download/latest.json",
        "https://mirror.ghproxy.com/https://github.com/aeroray/Museek/releases/latest/download/latest.json",
        "https://gh.llkk.cc/https://github.com/aeroray/Museek/releases/latest/download/latest.json",
        "https://ghfast.top/https://github.com/aeroray/Museek/releases/latest/download/latest.json",
        "https://github.com/aeroray/Museek/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
