{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-minimize",
    "core:window:allow-unminimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-close",
    "core:window:allow-set-fullscreen",
    "core:window:allow-set-size",
    "core:window:allow-set-min-size",
    "core:window:allow-set-max-size",
    "core:window:allow-set-position",
    "core:window:allow-set-skip-taskbar",
    "core:window:allow-set-always-on-top",
    "core:window:allow-set-decorations",
    "core:window:allow-set-shadow",
    "core:window:allow-set-resizable",
    "core:window:allow-set-title-bar-style",
    "core:window:allow-set-title",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    "http:default",
    {
      "identifier": "http:allow-fetch",
      "allow": [{ "url": "http://**" }, { "url": "https://**" }]
    },
    "fs:default",
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        { "path": "$APPDATA/**" },
        { "path": "$APPLOCALDATA/**" },
        { "path": "$CACHE/**" },
        { "path": "$HOME/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$DOWNLOAD/**" },
        { "path": "$AUDIO/**" },
        { "path": "**/*.mp3" },
        { "path": "**/*.flac" },
        { "path": "**/*.m4a" },
        { "path": "**/*.aac" },
        { "path": "**/*.ogg" },
        { "path": "**/*.wav" },
        { "path": "**/*.cue" },
        { "path": "**/*.lrc" },
        { "path": "**/*.js" },
        { "path": "**/*.json" }
      ]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [
        { "path": "$APPDATA/**" },
        { "path": "$APPLOCALDATA/**" },
        { "path": "$CACHE/**" },
        { "path": "$TEMP/**" },
        { "path": "$HOME/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$DOWNLOAD/**" },
        { "path": "$AUDIO/**" },
        { "path": "**/*.json" }
      ]
    },
    {
      "identifier": "fs:allow-read-file",
      "allow": [
        { "path": "$APPDATA/**" },
        { "path": "$APPLOCALDATA/**" },
        { "path": "$CACHE/**" },
        { "path": "$HOME/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$DOWNLOAD/**" },
        { "path": "$AUDIO/**" },
        { "path": "**/*.mp3" },
        { "path": "**/*.flac" },
        { "path": "**/*.m4a" },
        { "path": "**/*.aac" },
        { "path": "**/*.ogg" },
        { "path": "**/*.wav" },
        { "path": "**/*.cue" },
        { "path": "**/*.jpg" },
        { "path": "**/*.jpeg" },
        { "path": "**/*.png" },
        { "path": "**/*.webp" }
      ]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [
        { "path": "$APPDATA/**" },
        { "path": "$APPLOCALDATA/**" },
        { "path": "$CACHE/**" },
        { "path": "$TEMP/**" },
        { "path": "$HOME/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$DOWNLOAD/**" },
        { "path": "$AUDIO/**" },
        { "path": "**/*.mp3" },
        { "path": "**/*.flac" },
        { "path": "**/*.m4a" },
        { "path": "**/*.aac" },
        { "path": "**/*.ogg" },
        { "path": "**/*.wav" },
        { "path": "**/*.cue" },
        { "path": "**/*.lrc" },
        { "path": "**/*.json" },
        { "path": "**/*.jpg" },
        { "path": "**/*.jpeg" },
        { "path": "**/*.png" },
        { "path": "**/*.webp" }
      ]
    },
    {
      "identifier": "fs:allow-read-dir",
      "allow": [
        { "path": "$APPDATA/**" },
        { "path": "$APPLOCALDATA/**" },
        { "path": "$HOME/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$DOWNLOAD/**" },
        { "path": "$AUDIO/**" }
      ]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [
        { "path": "$APPDATA/**" },
        { "path": "$APPLOCALDATA/**" },
        { "path": "$CACHE/**" },
        { "path": "$TEMP/**" },
        { "path": "$HOME/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$DOWNLOAD/**" },
        { "path": "$AUDIO/**" },
        { "path": "**/*.mp3" },
        { "path": "**/*.flac" },
        { "path": "**/*.m4a" },
        { "path": "**/*.aac" },
        { "path": "**/*.ogg" },
        { "path": "**/*.wav" },
        { "path": "**/*.json" },
        { "path": "**/*.jpg" },
        { "path": "**/*.jpeg" },
        { "path": "**/*.png" },
        { "path": "**/*.webp" }
      ]
    },
    "fs:allow-appdata-read-recursive",
    "fs:allow-appdata-write-recursive",
    {
      "identifier": "fs:allow-write-file",
      "allow": [
        { "path": "$APPDATA/**" },
        { "path": "$APPLOCALDATA/**" },
        { "path": "$CACHE/**" },
        { "path": "$TEMP/**" },
        { "path": "$HOME/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$DOWNLOAD/**" },
        { "path": "$AUDIO/**" },
        { "path": "**/*.mp3" },
        { "path": "**/*.flac" },
        { "path": "**/*.m4a" },
        { "path": "**/*.aac" },
        { "path": "**/*.ogg" },
        { "path": "**/*.wav" },
        { "path": "**/*.json" },
        { "path": "**/*.jpg" },
        { "path": "**/*.jpeg" },
        { "path": "**/*.png" },
        { "path": "**/*.webp" }
      ]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        { "path": "$APPDATA/**" },
        { "path": "$APPLOCALDATA/**" },
        { "path": "$CACHE/**" },
        { "path": "$TEMP/**" },
        { "path": "$HOME/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$DOWNLOAD/**" },
        { "path": "$AUDIO/**" }
      ]
    },
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "shell:allow-open",
    "clipboard-manager:allow-read-text",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "global-shortcut:allow-unregister-all",
    "global-shortcut:allow-is-registered",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        { "path": "**" },
        { "path": "$APPDATA/**" },
        { "path": "$HOME/**" },
        { "path": "$DOWNLOAD/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$AUDIO/**" },
        { "path": "$VIDEO/**" }
      ]
    },
    {
      "identifier": "opener:allow-reveal-item-in-dir",
      "allow": [
        { "path": "**" },
        { "path": "$APPDATA/**" },
        { "path": "$HOME/**" },
        { "path": "$DOWNLOAD/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$AUDIO/**" },
        { "path": "$VIDEO/**" }
      ]
    }
  ]
}
