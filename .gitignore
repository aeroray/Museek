# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Claude Code — commit shared config (e.g. .claude/launch.json) but keep
# personal/local settings (machine paths + permission allowlist) out of git.
.claude/settings.local.json

# Build artifacts that may appear at the repo root on Windows
src-tauri/target/
*.exe.bak

# Updater signing private keys (never commit)
*.key
!*.key.pub
.tauri/

# Local development scripts and one-off investigation tools. Not part of the app:
# nothing in src/, src-tauri/, package.json or CI imports them, and they are not
# bundled. Kept out of version control deliberately. The leading slash anchors
# this to the repo root so a nested `scripts/` directory is not swept up too.
/scripts/