# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Claude Code — commit shared config (e.g. .claude/launch.json) but keep
# personal/local settings (machine paths + permission allowlist) out of git.
.claude/settings.local.json

# Build artifacts that may appear at the repo root on Windows
src-tauri/target/
*.exe.bak

# Updater signing private keys (never commit)
*.key
!*.key.pub
.tauri/

# One-off investigation tools live in scripts/ and stay out of version control:
# they are throwaway probes against live platform APIs whose findings already
# live in the code and in docs/memory/.
/scripts/
# ...except the regression checks. These are the project's only automated tests:
# pure-logic or headless-browser harnesses that pin bugs we have actually shipped,
# so they belong in the repo and stay runnable by anyone (and by CI).
!/scripts/
/scripts/*
!/scripts/check-*.mjs
!/scripts/run-checks.mjs
!/scripts/lib/
!/scripts/lib/**
# Transient commit-message file (PowerShell heredocs are not supported here)
.git-commit-msg.txt
